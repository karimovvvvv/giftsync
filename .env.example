# ─── Backend ───────────────────────────────────────────────
# Формат: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/giftsync

# Секретный ключ для JWT — замените в продакшене (минимум 32 символа)
SECRET_KEY=change-me-in-production-use-a-long-random-string

# Время жизни токена в минутах (по умолчанию 7 дней)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Алгоритм подписи JWT
ALGORITHM=HS256

# Разрешённые CORS-источники (JSON-массив строк)
CORS_ORIGINS=["http://localhost:3000"]

# ─── Frontend ───────────────────────────────────────────────
# URL бэкенда (без trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000

# URL для WebSocket соединений
NEXT_PUBLIC_WS_URL=ws://localhost:8000
